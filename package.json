{
  "name": "meu-caixa",
  "version": "0.1.0",
  "private": true,
  "description": "Meu Caixa: app financeiro pessoal com leitura de cupom fiscal no aparelho",
  "scripts": {
    "assets": "node scripts/copy-assets.js",
    "build": "npm run assets",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "test": "node scripts/test-parser.js && node scripts/test-extrato.js"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/privacy-screen": "^2.0.1",
    "@capgo/capacitor-native-biometric": "^8.9.3",
    "@tesseract.js-data/por": "1.0.0",
    "jsqr": "1.4.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  }
}
